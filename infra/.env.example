# ============================================
# StockLens AI - Docker Compose (Local / Dev)
# ============================================
# Use this for: Local development with Docker Compose
# Copy this file to .env and update values as needed


# ----------------------------
# PostgreSQL (Local Docker DB)
# ----------------------------
POSTGRES_USER=stocklens
POSTGRES_PASSWORD=password
POSTGRES_DB=stocklens_db


# ----------------------------
# Backend Configuration
# ----------------------------

# NVIDIA LLM
NVIDIA_API_KEY=nvidia-api-key

# Alpha Vantage (Market Data)
ALPHA_VANTAGE_API_KEY=alpha-vantage-api-key

# CORS (Local Frontend Origins)
CORS_ORIGINS=http://localhost:3000,http://localhost


# ----------------------------
# Frontend Configuration
# ----------------------------

# Backend API URL (Local)
NEXT_PUBLIC_API_BASE_URL=http://localhost