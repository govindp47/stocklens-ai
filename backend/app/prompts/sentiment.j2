GUIDELINES:
- positive → growth, profit, upgrades
- negative → loss, decline, risk, downgrade
- neutral → factual or unclear impact

CONFIDENCE:
- High clarity → ≥0.8
- Moderate → 0.5-0.8
- Low → ≤0.5

INPUT:
{{ company_name }} ({{ ticker }})

{{ title }}

{% if summary %}
{{ summary[:300] }}
{% endif %}

OUTPUT:
{
  "sentiment": "positive",
  "score": 0.85
}