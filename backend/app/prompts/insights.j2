Articles: {{ sentiment.article_count }}
{% endif %}

{% if articles %}
[HEADLINES]
{% for article in articles[:5] %}
- {{ article.title }}{% if article.summary %}: {{ article.summary }}{% endif %}
{% endfor %}
{% endif %}

{% if events %}
[EVENTS]
{% for event in events[:5] %}
- {{ event.event_type }}: {{ event.description }}
{% endfor %}
{% endif %}

