# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://stocklens:password@db:5432/stocklens

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection string; DB index 0 for dev
REDIS_URL=redis://redis:6379/0

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Base URL for the local Ollama inference server
OLLAMA_URL=http://ollama:11434

# Default model to load; must be pulled via: ollama pull mistral:7b-instruct
DEFAULT_LLM_MODEL=mistral:7b-instruct

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# Max simultaneous LLM calls across all pipeline runs (Ollama capacity)
MAX_CONCURRENT_LLM_CALLS=2

# Hard timeout in seconds for the full analysis pipeline
PIPELINE_TIMEOUT_SECONDS=90

# Maximum number of news articles fetched and processed per run
MAX_ARTICLES_PER_RUN=20

# Number of calendar days back to fetch news articles
NEWS_WINDOW_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Allowed requests per IP per sliding window (relaxed in dev)
RATE_LIMIT_REQUESTS=100

# Sliding window duration in seconds for rate limiting
RATE_LIMIT_WINDOW_SECONDS=60

# ── Data retention ────────────────────────────────────────────────────────────
# How many hours to retain completed pipeline run data in the database
RUN_RETENTION_HOURS=24

# ── Application ───────────────────────────────────────────────────────────────
# Runtime environment: development | test | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# ── Backup (production only) ──────────────────────────────────────────────────
# AES-256 key for encrypting database backups before S3 upload (leave blank in dev)
BACKUP_ENCRYPTION_KEY=

# S3 bucket name for storing encrypted database backups (leave blank in dev)
BACKUP_S3_BUCKET=
