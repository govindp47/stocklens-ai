# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://stocklens:password@localhost:5432/stocklens

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection string; DB index 0 for dev
REDIS_URL=redis://localhost:6379/0

# ── NVIDIA LLM ────────────────────────────────────────────────────────────────
# NVIDIA API key for free hosted models
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Base URL for the local Ollama inference server
OLLAMA_URL=http://localhost:11434

# ── Market data providers ─────────────────────────────────────────────────────
# Alpha Vantage API key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ── Application ───────────────────────────────────────────────────────────────
# Runtime environment: development | test | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173